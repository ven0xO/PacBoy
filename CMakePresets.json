{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with tests enabled",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "PACBOY_ENABLE_CLANG_TIDY": false,
        "PACBOY_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "test",
      "inherits": "debug",
      "displayName": "Test",
      "description": "Debug build dedicated to running tests",
      "binaryDir": "${sourceDir}/build/test"
    },
    {
      "name": "release",
      "inherits": "debug",
      "displayName": "Release",
      "description": "Optimized release build without tests",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false
      }
    },
    {
      "name": "tidy",
      "inherits": "test",
      "displayName": "Clang-Tidy",
      "description": "Debug build with clang-tidy enabled",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {
        "PACBOY_ENABLE_CLANG_TIDY": true,
        "PACBOY_ENABLE_SANITIZERS": false
      }
    },
    {
      "name": "sanitizers",
      "inherits": "test",
      "displayName": "Sanitizers",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": {
        "PACBOY_ENABLE_CLANG_TIDY": false,
        "PACBOY_ENABLE_SANITIZERS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug"
    },
    {
      "name": "test",
      "displayName": "Build Tests",
      "configurePreset": "test"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    },
    {
      "name": "tidy",
      "displayName": "Build with Clang-Tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "sanitizers",
      "displayName": "Build with Sanitizers",
      "configurePreset": "sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "displayName": "Run Tests",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "displayName": "Run Tests with Sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
